NOWUP_ADMIN_EMAIL=admin@seudominio.com.br
NOWUP_ADMIN_PASSWORD=troque-por-uma-senha-forte
NOWUP_HTTPS=1

# E-mail transacional / confirmação de cadastro
BREVO_API_KEY=
NOWUP_EMAIL_FROM=seu-email-verificado@seudominio.com.br
NOWUP_BASE_URL=https://endereco-exato-do-seu-site.onrender.com

# Optional canonical public origin for browser mutation validation (scheme + host).
# NOWUP_PUBLIC_ORIGIN=https://your-nowup-domain.example

# Optional dedicated catalogue origin. Leave unset until domain, DNS and TLS
# are connected to THIS same Render service and verified. Never use the
# marketplace origin here. This switches external links and store email links.
# NOWUP_MENU_ORIGIN=https://menu.your-nowup-domain.example

# Banco: SQLite continua padrão até a troca validada.
NOWUP_DB_ENGINE=sqlite
# DATABASE_URL deve ser configurada no Render; não publicar credenciais.
# DATABASE_URL=
NOWUP_PG_POOL_SIZE=8
# Schema PostgreSQL do ensaio importado (o importador recusa public).
# NOWUP_PG_SCHEMA=nowup_migration_ensaio
# Backups PostgreSQL exigem pg_dump e pg_restore compatíveis com o servidor.
